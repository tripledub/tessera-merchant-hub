# Copy to .env and fill in values for local development

# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgres://merchanthub:password@localhost:5433/merchanthub_development

# tessera-core service URL and internal API key
TESSERA_CORE_URL=http://localhost:4000
TESSERA_INTERNAL_API_KEY=dev-internal-api-key

# MerchantHub demo seed data
DEMO_MERCHANT_ID=merch_demo
DEMO_USER_PASSWORD=password123!

# Dev-only Claude OCR adapter (MH-69)
# Set CLAUDE_OCR=true to use Claude instead of kynetic-ocr for document extraction.
# The API key is stored in Rails credentials (rails credentials:edit), not here.
#   anthropic_api_key: sk-ant-...
# CLAUDE_OCR=true

# Admin Applicant deletion — UAT only (MH-170)
# Set APPLICANT_DELETE_ENABLED=true to enable the destroy action/UI in this environment.
# Must never be set in production — deleting an Applicant purges its KYC data.
# APPLICANT_DELETE_ENABLED=true

# AnyCable / Redis pub/sub (MH-185)
# In dev/CI: standard Redis. In production: Dragonfly (drop-in, infra-level swap via REDIS_URL).
REDIS_URL=redis://localhost:6379/1
ANYCABLE_SECRET=changeme-dev-secret
