<%# locals: (document:, errored_role: nil, errors: nil) %>
<div class="fixed inset-0 z-[9999] flex items-center justify-center px-4"
     data-controller="modal"
     data-modal-frame-value="document-date-confirmation-modal"
     data-action="keydown.esc@window->modal#close"
     role="dialog"
     aria-modal="true"
     aria-labelledby="document-date-confirmation-modal-title document-date-confirmation-modal-filename">

  <div class="absolute inset-0 bg-gray-900/60" data-action="click->modal#close" aria-hidden="true"></div>

  <div class="relative w-full max-w-lg">
    <div class="card">
      <div class="mb-4 flex items-start justify-between gap-4">
        <div class="min-w-0">
          <p id="document-date-confirmation-modal-title" class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
            <%= t("kyc.documents.date_confirmations.modal_title") %>
          </p>
          <p id="document-date-confirmation-modal-filename" class="mt-0.5 text-theme-sm text-gray-900 truncate dark:text-white/90">
            <%= document.file.filename %>
          </p>
        </div>
        <button type="button"
                class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
                data-action="click->modal#close"
                aria-label="<%= t('kyc.documents.comments.close') %>">
          <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/>
          </svg>
        </button>
      </div>

      <% present(document, Kyc::DocumentDateConfirmationPresenter) do |presenter| %>
        <div class="space-y-3">
          <% presenter.date_roles.each do |date_role| %>
            <%= render "kyc/document_date_confirmations/date_confirmation",
                  document: document, date_role: date_role, presenter: presenter,
                  errors: (errored_role == date_role ? errors : nil) %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
