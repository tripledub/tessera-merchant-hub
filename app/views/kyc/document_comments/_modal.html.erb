<%# locals: (kyc_document:, comment_errors: nil) %>
<turbo-frame id="document-comments-modal">
  <div class="fixed inset-0 z-[9999] flex items-center justify-center px-4"
       data-controller="modal"
       data-modal-frame-value="document-comments-modal"
       data-action="keydown.esc@window->modal#close">

    <div class="absolute inset-0 bg-gray-900/60" data-action="click->modal#close" aria-hidden="true"></div>

    <div class="relative w-full max-w-lg" data-action="click->modal#close:stop">
      <div class="card">
        <div class="mb-4 flex items-start justify-between gap-4">
          <div class="min-w-0">
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
              <%= t("kyc.documents.comments.title") %>
            </p>
            <p class="mt-0.5 text-theme-sm text-gray-900 truncate dark:text-white/90">
              <%= kyc_document.file.filename %>
            </p>
          </div>
          <button type="button"
                  class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
                  data-action="click->modal#close"
                  aria-label="<%= t('kyc.documents.comments.close') %>">
            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/>
            </svg>
          </button>
        </div>

        <div class="mb-4 flex items-center gap-2">
          <%= button_to t("kyc.documents.comments.mark_requires_follow_up"),
                comment_status_kyc_document_path(kyc_document),
                method: :patch,
                params: { comment_status: "requires_follow_up" },
                class: "btn-secondary text-xs #{'ring-2 ring-warning-400' if kyc_document.comment_requires_follow_up?}" %>
          <%= button_to t("kyc.documents.comments.mark_resolved"),
                comment_status_kyc_document_path(kyc_document),
                method: :patch,
                params: { comment_status: "resolved" },
                class: "btn-secondary text-xs #{'ring-2 ring-success-400' if kyc_document.comment_resolved?}" %>
        </div>

        <div class="max-h-80 space-y-3 overflow-y-auto">
          <% if kyc_document.comments.none? %>
            <p class="text-theme-sm text-gray-500 dark:text-gray-400"><%= t("kyc.documents.comments.empty") %></p>
          <% else %>
            <% kyc_document.comments.each do |comment| %>
              <div class="border-b border-gray-100 pb-2 last:border-b-0 dark:border-gray-800">
                <div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
                  <span class="font-medium text-gray-700 dark:text-gray-300"><%= comment.author.email %></span>
                  <span><%= l(comment.created_at, format: :long) %></span>
                </div>
                <p class="mt-1 text-theme-sm text-gray-900 dark:text-white/90"><%= comment.body %></p>
              </div>
            <% end %>
          <% end %>
        </div>

        <% if comment_errors.present? %>
          <p class="mt-4 text-error-500"><%= comment_errors.full_messages.to_sentence %></p>
        <% end %>

        <%= form_with url: kyc_document_comments_path(kyc_document), method: :post, class: "mt-4" do |f| %>
          <%= f.text_area :body, rows: 3, required: true,
                placeholder: t("kyc.documents.comments.placeholder"),
                class: "form-input w-full" %>
          <%= f.submit t("kyc.documents.comments.add"), class: "btn-primary mt-2" %>
        <% end %>
      </div>
    </div>
  </div>
</turbo-frame>
