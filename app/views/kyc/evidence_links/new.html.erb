<% content_for :title, t('.page_title') %>

<turbo-frame id="applicant-domain-modal">
  <div data-controller="modal" data-modal-frame-value="applicant-domain-modal"
       data-action="keydown.esc@window->modal#close"
       class="fixed inset-0 z-50 flex items-center justify-center">
    <%# Backdrop %>
    <div data-action="click->modal#close" class="absolute inset-0 bg-gray-900/50 backdrop-blur-sm"></div>

    <%# Modal card %>
    <div class="relative z-10 w-full max-w-md rounded-2xl border border-gray-200 bg-white p-6 shadow-xl dark:border-gray-800 dark:bg-gray-900"
         data-action="click->modal#nothing">
      <div class="mb-5 flex items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900 dark:text-white"><%= t('.title', domain: applicant_domain.name) %></h2>
        <button type="button" data-action="click->modal#close"
                class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
          <svg class="fill-current" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M5.293 5.293a1 1 0 0 1 1.414 0L12 10.586l5.293-5.293a1 1 0 1 1 1.414 1.414L13.414 12l5.293 5.293a1 1 0 0 1-1.414 1.414L12 13.414l-5.293 5.293a1 1 0 0 1-1.414-1.414L10.586 12 5.293 6.707a1 1 0 0 1 0-1.414z" fill=""/>
          </svg>
        </button>
      </div>

      <% if @available_documents.empty? %>
        <p class="text-theme-sm text-gray-500 dark:text-gray-400"><%= t('.none_available') %></p>
        <div class="flex gap-3 pt-4">
          <button type="button" data-action="click->modal#close" class="btn-secondary"><%= t('.cancel') %></button>
        </div>
      <% else %>
        <%= form_with url: kyc_applicant_domain_evidence_links_path(applicant_domain), scope: :evidence_link, class: "space-y-4" do |f| %>
          <% if @error %>
            <p class="text-theme-sm text-error-600" role="alert"><%= @error %></p>
          <% end %>

          <div>
            <%= f.label :kyc_document_id, t('.document'), class: "form-label" %>
            <%= f.select :kyc_document_id,
                  @available_documents.map { |doc| [ "#{doc.file.filename} — #{l(doc.created_at.to_date, format: :long)}", doc.id ] },
                  { include_blank: t('.choose') },
                  class: "form-input", required: true %>
          </div>

          <div class="flex gap-3 pt-2">
            <%= f.submit t('.submit'), class: "btn-primary" %>
            <button type="button" data-action="click->modal#close" class="btn-secondary"><%= t('.cancel') %></button>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</turbo-frame>
