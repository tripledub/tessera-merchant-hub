<% accept_label = applicant_domain.rejected? ? t("kyc.applicant_domains.undo_reject") : t("kyc.applicant_domains.accept") %>
<% review_badge = { "pending" => "badge-warning", "accepted" => "badge-success", "rejected" => "badge-error" }.fetch(applicant_domain.review_status) %>
<tr id="<%= dom_id(applicant_domain) %>" class="hover:bg-gray-50 dark:hover:bg-white/[0.03] <%= "opacity-60" if applicant_domain.rejected? %>">
  <td class="py-2 pr-4">
    <div class="font-medium text-gray-900 dark:text-white/90 <%= "line-through" if applicant_domain.rejected? %>">
      <%= applicant_domain.name %>
    </div>
    <% evidence_links = applicant_domain.evidence_links.sort_by(&:created_at) %>
    <div class="mt-0.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500 dark:text-gray-400">
      <% evidence_links.each do |link| %>
        <% document = link.kyc_document %>
        <span class="inline-flex items-center gap-1">
          <% if document.previewable? %>
            <button type="button"
                    data-controller="document-preview"
                    data-document-preview-url-value="<%= rails_blob_path(document.file, disposition: :inline) %>"
                    data-document-preview-content-type-value="<%= document.file.content_type %>"
                    data-action="click->document-preview#open"
                    title="<%= t("kyc.documents.preview") %>"
                    class="text-brand-600 hover:underline dark:text-brand-400"><%= document.file.filename %></button>
          <% else %>
            <span><%= document.file.filename %></span>
          <% end %>
          <% if policy(applicant_domain).detach_evidence? %>
            <%= button_to kyc_evidence_link_path(link), method: :delete,
                  form: { class: "inline" },
                  title: t("kyc.applicant_domains.evidence.unlink"),
                  "aria-label": t("kyc.applicant_domains.evidence.unlink"),
                  data: { turbo_confirm: t("kyc.applicant_domains.evidence.unlink_confirm", filename: document.file.filename, domain: applicant_domain.name) },
                  class: "text-gray-400 hover:text-error-500 dark:hover:text-error-400" do %>
              <svg class="fill-current" width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M5.293 5.293a1 1 0 0 1 1.414 0L12 10.586l5.293-5.293a1 1 0 1 1 1.414 1.414L13.414 12l5.293 5.293a1 1 0 0 1-1.414 1.414L12 13.414l-5.293 5.293a1 1 0 0 1-1.414-1.414L10.586 12 5.293 6.707a1 1 0 0 1 0-1.414z" fill=""/>
              </svg>
            <% end %>
          <% end %>
        </span>
      <% end %>
      <% if evidence_links.empty? %>
        <span class="italic"><%= t("kyc.applicant_domains.evidence.none") %></span>
      <% end %>
      <% if policy(applicant_domain).attach_evidence? %>
        <%= link_to t("kyc.applicant_domains.evidence.add"),
              new_kyc_applicant_domain_evidence_link_path(applicant_domain),
              data: { turbo_frame: "applicant-domain-modal" },
              class: "text-brand-600 hover:underline dark:text-brand-400" %>
      <% end %>
    </div>
    <% note = applicant_domain.comments.last %>
    <% if note %>
      <div class="mt-1 text-xs text-gray-500 dark:text-gray-400">
        <span class="font-medium"><%= t("kyc.applicant_domains.note.label") %>:</span>
        <span class="line-clamp-2" title="<%= note.body %>"><%= note.body %></span>
        <span class="italic"><%= t("kyc.applicant_domains.note.attribution", author: note.author.email, date: l(note.created_at.to_date, format: :long)) %></span>
      </div>
    <% end %>
  </td>
  <td class="px-4 py-2 text-gray-500 dark:text-gray-400">
    <span class="badge <%= review_badge %>">
      <%= t("kyc.applicant_domains.review_status.#{applicant_domain.review_status}") %>
    </span>
  </td>
  <td class="px-4 py-2 text-gray-500 dark:text-gray-400">
    <span class="badge <%= applicant_domain.verified? ? 'badge-success' : 'badge-gray' %>">
      <%= t("kyc.applicant_domains.verification_status.#{applicant_domain.verification_status}") %>
    </span>
  </td>
  <td class="px-4 py-2">
    <div class="flex items-center gap-2">
    <% if (applicant_domain.pending? || applicant_domain.rejected?) && policy(applicant_domain).accept? %>
      <% check_icon = capture do %>
        <svg class="fill-current" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M20.707 5.293a1 1 0 0 1 0 1.414l-11 11a1 1 0 0 1-1.414 0l-5-5a1 1 0 1 1 1.414-1.414L9 15.586 19.293 5.293a1 1 0 0 1 1.414 0z" fill=""/>
        </svg>
      <% end %>
      <% if evidence_links.any? %>
        <%= button_to accept_kyc_applicant_domain_path(applicant_domain), method: :patch,
              title: accept_label,
              "aria-label": accept_label,
              class: "text-gray-400 hover:text-success-500 dark:hover:text-success-400" do %>
          <%= check_icon %>
        <% end %>
      <% else %>
        <%# No evidence: accepting needs a comment saying why (MH-300). %>
        <%= link_to accept_form_kyc_applicant_domain_path(applicant_domain),
              title: t("kyc.applicant_domains.accept_without_evidence"),
              "aria-label": t("kyc.applicant_domains.accept_without_evidence"),
              data: { turbo_frame: "applicant-domain-modal" },
              class: "text-gray-400 hover:text-success-500 dark:hover:text-success-400" do %>
          <%= check_icon %>
        <% end %>
      <% end %>
    <% end %>
    <% if applicant_domain.pending? && policy(applicant_domain).reject? %>
      <%= button_to reject_kyc_applicant_domain_path(applicant_domain), method: :patch,
            title: t("kyc.applicant_domains.reject"),
            "aria-label": t("kyc.applicant_domains.reject"),
            class: "text-gray-400 hover:text-error-500 dark:hover:text-error-400" do %>
        <svg class="fill-current" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M5.293 5.293a1 1 0 0 1 1.414 0L12 10.586l5.293-5.293a1 1 0 1 1 1.414 1.414L13.414 12l5.293 5.293a1 1 0 0 1-1.414 1.414L12 13.414l-5.293 5.293a1 1 0 0 1-1.414-1.414L10.586 12 5.293 6.707a1 1 0 0 1 0-1.414z" fill=""/>
        </svg>
      <% end %>
    <% end %>
    <% if policy(applicant_domain).destroy? %>
      <%= button_to kyc_applicant_domain_path(applicant_domain), method: :delete,
            title: t('kyc.applicant_domains.delete'),
            data: { turbo_confirm: t('kyc.applicant_domains.delete_confirm', name: applicant_domain.name) },
            class: "text-gray-400 hover:text-error-500 dark:hover:text-error-400" do %>
        <svg class="fill-current" width="18" height="18" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M7.04142 4.29199C7.04142 3.04935 8.04878 2.04199 9.29142 2.04199H11.7081C12.9507 2.04199 13.9581 3.04935 13.9581 4.29199V4.54199H16.1252H17.166C17.5802 4.54199 17.916 4.87778 17.916 5.29199C17.916 5.70621 17.5802 6.04199 17.166 6.04199H16.8752V8.74687V13.7469V16.7087C16.8752 17.9513 15.8678 18.9587 14.6252 18.9587H6.37516C5.13252 18.9587 4.12516 17.9513 4.12516 16.7087V13.7469V8.74687V6.04199H3.8335C3.41928 6.04199 3.0835 5.70621 3.0835 5.29199C3.0835 4.87778 3.41928 4.54199 3.8335 4.54199H4.87516H7.04142V4.29199ZM15.3752 13.7469V8.74687V6.04199H13.9581H13.2081H7.79142H7.04142H5.62516V8.74687V13.7469V16.7087C5.62516 17.1229 5.96095 17.4587 6.37516 17.4587H14.6252C15.0394 17.4587 15.3752 17.1229 15.3752 16.7087V13.7469ZM8.54142 4.54199H12.4581V4.29199C12.4581 3.87778 12.1223 3.54199 11.7081 3.54199H9.29142C8.87721 3.54199 8.54142 3.87778 8.54142 4.29199V4.54199ZM8.8335 8.50033C9.24771 8.50033 9.5835 8.83611 9.5835 9.25033V14.2503C9.5835 14.6645 9.24771 15.0003 8.8335 15.0003C8.41928 15.0003 8.0835 14.6645 8.0835 14.2503V9.25033C8.0835 8.83611 8.41928 8.50033 8.8335 8.50033ZM12.9168 9.25033C12.9168 8.83611 12.581 8.50033 12.1668 8.50033C11.7526 8.50033 11.4168 8.83611 11.4168 9.25033V14.2503C11.4168 14.6645 11.7526 15.0003 12.1668 15.0003C12.581 15.0003 12.9168 14.6645 12.9168 14.2503V9.25033Z" fill=""/>
        </svg>
      <% end %>
    <% end %>
    </div>
  </td>
</tr>
