<div id="kyc_document_<%= document.id %>_metadata">
  <%# MH-302: read by document_panels_controller.js to move this row into the
      right Documents-tab panel. Lives in this safely-broadcastable partial (see
      KycDocumentBroadcaster) so it's fresh after every job-triggered update, not
      just ones the acting user's own request re-renders. %>
  <span class="hidden" data-status-group="<%= document.status_group %>"></span>

  <% unlinked = document.complete? && document.principal_linkable? %>
  <% has_principal_info = document.kyc_principal || unlinked %>

  <div class="px-4 py-3 text-theme-sm hover:bg-gray-50 dark:hover:bg-white/[0.03]">
    <div class="grid grid-cols-8 items-center gap-3">
      <div class="col-span-3 flex min-w-0 items-center gap-3">
        <% if document.file.attached? %>
          <button type="button"
                  data-controller="document-preview"
                  data-document-preview-url-value="<%= rails_blob_path(document.file, disposition: :inline) %>"
                  data-document-preview-content-type-value="<%= document.file.content_type %>"
                  data-action="click->document-preview#open"
                  title="<%= t('kyc.documents.preview') %>"
                  aria-label="<%= t('kyc.documents.preview') %>"
                  class="flex-shrink-0 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
            </svg>
          </button>
        <% else %>
          <svg class="h-5 w-5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
          </svg>
        <% end %>
        <div class="min-w-0">
          <p class="font-medium text-gray-900 dark:text-white/90 truncate"><%= document.file.filename %></p>
          <p class="text-xs text-gray-500 dark:text-gray-400">
            <%= document.document_type.present? ? t("kyc.documents.document_types.#{document.document_type}") : t("kyc.documents.classification.status.unclassified") %>
          </p>
        </div>
      </div>

      <div class="col-span-2 flex flex-wrap items-center gap-1.5">
        <%# Both badges: classification state is still worth showing once
            confirmed (it's the record that a reviewer acted on this document,
            not just what its extraction is currently doing). %>
        <% if document.classification_status.present? && document.classification_status != "unclassified" %>
          <% classification_badge_class = { "auto_classified" => "badge-gray", "ai_suggested" => "badge-warning", "confirmed" => "badge-success", "rejected" => "badge-error" }.fetch(document.classification_status, "badge-gray") %>
          <span class="badge <%= classification_badge_class %>"><%= t("kyc.documents.classification.status.#{document.classification_status}") %></span>
        <% end %>
        <% if document.classification_confirmed? %>
          <% status_badge_class = { "pending" => "badge-gray", "processing" => "badge-info", "complete" => "badge-success", "error" => "badge-error" }.fetch(document.status) %>
          <span class="badge <%= status_badge_class %>"><%= t("kyc.documents.status.#{document.status}") %></span>
        <% end %>
      </div>

      <div class="col-span-2 min-w-0 text-xs text-gray-500 dark:text-gray-400">
        <% if document.kyc_principal %>
          <p class="truncate text-gray-700 dark:text-gray-300"><%= document.kyc_principal.name %></p>
          <div class="mt-0.5 flex flex-wrap items-center gap-1">
            <% if document.match_method == "fuzzy" %>
              <span class="inline-flex items-center whitespace-nowrap rounded-full bg-yellow-100 px-1.5 py-0.5 font-medium text-yellow-700"><%= t("kyc.documents.match_method.fuzzy") %></span>
            <% end %>
            <% if document.match_method == "registry_corroborated" %>
              <span class="inline-flex items-center whitespace-nowrap rounded-full bg-green-100 px-1.5 py-0.5 font-medium text-green-700"><%= t("kyc.documents.match_method.registry_corroborated") %></span>
            <% end %>
            <% if document.match_method == "override_linked" %>
              <span class="inline-flex items-center whitespace-nowrap rounded-full bg-blue-100 px-1.5 py-0.5 font-medium text-blue-700"><%= t("kyc.documents.match_method.override_linked") %></span>
            <% end %>
            <% if document.kyc_principal.unconfirmed? %>
              <span class="inline-flex items-center whitespace-nowrap rounded-full bg-orange-100 px-1.5 py-0.5 font-medium text-orange-700"><%= t("kyc.documents.principal_status.unconfirmed") %></span>
            <% end %>
          </div>
        <% elsif unlinked %>
          <span class="italic"><%= t("kyc.documents.unlinked") %></span>
        <% else %>
          &mdash;
        <% end %>
      </div>

      <div class="col-span-1 flex items-center justify-end gap-1">
        <% unless document.classification_confirmed? || document.processing? || document.processing_statement %>
          <div class="flex items-center gap-1" data-controller="classification" data-classification-url-value="<%= kyc_document_path(document) %>" data-classification-status-value="<%= document.classification_status %>">
            <select data-classification-target="select"
                    data-action="change->classification#change"
                    class="rounded-md border border-gray-300 bg-white px-1.5 py-1 text-xs text-gray-700 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-300">
              <% if document.document_type.blank? %>
                <option value="" disabled selected><%= t("kyc.documents.select_type") %></option>
              <% end %>
              <% document.selectable_document_types.sort.each do |type| %>
                <option value="<%= type %>" <%= "selected" if type == document.document_type %>>
                  <%= t("kyc.documents.document_types.#{type}") %>
                </option>
              <% end %>
            </select>
            <%# MH-332: disabled whenever no real type is selected (either
                pre-selected, e.g. an AI/rule-based suggestion, or picked in
                this render) — confirming without one leaves the document
                permanently "Unclassified" with no way to extract it. %>
            <button type="button" data-classification-target="confirmButton"
                    data-action="click->classification#confirm"
                    title="<%= t('kyc.documents.confirm') %>"
                    aria-label="<%= t('kyc.documents.confirm') %>"
                    <%= "disabled" if document.document_type.blank? %>
                    class="text-gray-400 hover:text-success-500 dark:hover:text-success-400 disabled:opacity-40 disabled:pointer-events-none">
              <svg class="fill-current" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M20.707 5.293a1 1 0 0 1 0 1.414l-11 11a1 1 0 0 1-1.414 0l-5-5a1 1 0 1 1 1.414-1.414L9 15.586 19.293 5.293a1 1 0 0 1 1.414 0z" fill=""/>
              </svg>
            </button>
          </div>
        <% end %>

        <% if document.kyc_principal && (document.kyc_principal.unconfirmed? || document.match_method == "fuzzy") %>
          <%= button_to kyc_document_link_path(document), method: :patch,
                  title: t("kyc.documents.confirm_match"),
                  "aria-label": t("kyc.documents.confirm_match"),
                  class: "text-gray-400 hover:text-success-500 dark:hover:text-success-400" do %>
              <svg class="stroke-current" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 0 0-5.656 0l-4 4a4 4 0 1 0 5.656 5.656l1.102-1.101m-.758-4.899a4 4 0 0 0 5.656 0l4-4a4 4 0 0 0-5.656-5.656l-1.1 1.1"/>
              </svg>
            <% end %>
        <% end %>

        <div class="relative" data-controller="overflow-menu">
          <button type="button"
                  data-action="click->overflow-menu#toggle"
                  data-overflow-menu-target="button"
                  title="<%= t('kyc.documents.more_actions') %>"
                  aria-label="<%= t('kyc.documents.more_actions') %>"
                  aria-haspopup="true"
                  class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
            <svg class="fill-current" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4zm0 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4zm0 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/>
            </svg>
          </button>

          <%# MH-336: position is set to fixed by overflow_menu_controller.js
              on open, computed from the trigger's live position — not
              absolute/right-0 here, which used to clip against the
              Documents panel's overflow-hidden for the last row. %>
          <div data-overflow-menu-target="menu"
               class="hidden z-10 min-w-[10rem] rounded-md border border-gray-200 bg-white py-1 shadow-lg dark:border-gray-700 dark:bg-gray-800">
            <% if document.validity_dates.present? && viewer_can?(document, :confirm_dates?) %>
              <%= link_to t("kyc.documents.date_confirmations.menu_label"),
                      date_confirmation_modal_kyc_document_path(document),
                      data: { turbo_frame: "document-date-confirmation-modal" },
                      class: "block whitespace-nowrap px-3 py-1.5 text-xs text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-gray-700" %>
            <% end %>

            <% if document.error? %>
              <%= button_to t("kyc.documents.retry"), retry_kyc_document_path(document), method: :post,
                      class: "block w-full whitespace-nowrap px-3 py-1.5 text-left text-xs text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-gray-700",
                      form_class: "w-full" %>
            <% end %>

            <%# MH-327: other-typed documents have no extraction handler, so
                status never advances past :pending on its own — this is the
                only way one can ever reach the Processed panel. %>
            <% if document.other? && document.classification_confirmed? && !document.complete? && viewer_can?(document, :mark_reviewed?) %>
              <%= button_to t("kyc.documents.mark_reviewed"), mark_reviewed_kyc_document_path(document), method: :post,
                      class: "block w-full whitespace-nowrap px-3 py-1.5 text-left text-xs text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-gray-700",
                      form_class: "w-full" %>
            <% end %>

            <%= link_to t("kyc.documents.comments.open"),
                    kyc_document_comments_path(document),
                    id: "comments-trigger-#{document.id}",
                    data: { turbo_frame: "document-comments-modal" },
                    class: "block whitespace-nowrap px-3 py-1.5 text-xs text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-gray-700" %>

            <% if document.kyc_principal && (document.kyc_principal.unconfirmed? || document.match_method == "fuzzy") %>
              <%= button_to t("kyc.documents.reject_match"), kyc_document_link_path(document), method: :delete,
                      class: "block w-full whitespace-nowrap px-3 py-1.5 text-left text-xs text-error-600 hover:bg-gray-50 dark:text-error-400 dark:hover:bg-gray-700",
                      form_class: "w-full" %>
            <% end %>

            <%= button_to t("kyc.documents.delete"), kyc_document_path(document), method: :delete,
                    data: { turbo_confirm: t("kyc.documents.delete_confirm", filename: document.file.filename) },
                    class: "block w-full whitespace-nowrap px-3 py-1.5 text-left text-xs text-error-600 hover:bg-gray-50 dark:text-error-400 dark:hover:bg-gray-700",
                    form_class: "w-full" %>
          </div>
        </div>
      </div>
    </div>

    <% if has_principal_info || document.comment_status.present? || (document.proof_of_domain_ownership? && document.evidenced_domains.any?) || document.document_type.present? %>
      <div class="mt-2 space-y-1.5 border-t border-gray-100 pt-2 text-xs text-gray-500 dark:border-gray-800 dark:text-gray-400">
        <% if document.address_match_method.present? || document.comment_status.present? %>
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <% if document.address_match_method.present? %>
              <span class="inline-flex items-center whitespace-nowrap rounded-full px-1.5 py-0.5 font-medium <%= document.address_match_method == 'exact' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700' %>">
                <%= t("kyc.documents.address_match_method.#{document.address_match_method}") %>
              </span>
            <% end %>
            <% if document.comment_status.present? %>
              <span class="badge <%= document.comment_resolved? ? 'badge-success' : 'badge-warning' %>">
                <%= t("kyc.documents.comment_status.#{document.comment_status}") %>
              </span>
            <% end %>
          </div>
        <% end %>

        <% if document.proof_of_domain_ownership? && document.evidenced_domains.any? %>
          <%# Read-only: accepting, rejecting and (un)linking evidence happen on the Domains tab (MH-299). %>
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <span><%= t("kyc.documents.evidenced_domains") %></span>
            <% document.evidenced_domains.sort_by(&:name).each do |evidenced_domain| %>
              <% status_text = t("kyc.applicant_domains.review_status.#{evidenced_domain.review_status}") %>
              <span class="badge <%= { "pending" => "badge-warning", "accepted" => "badge-success", "rejected" => "badge-error" }.fetch(evidenced_domain.review_status) %>"
                    title="<%= status_text %>">
                <%= evidenced_domain.name %><span class="sr-only"> — <%= status_text %></span>
              </span>
            <% end %>
          </div>
        <% end %>

        <%# MH-323: gated on classification_confirmed? too, not just document_type —
            ExtractKycDocumentJob (which populates validity_dates) refuses to run
            until classification is confirmed, so before that point the assessor's
            "missing_required_date" reads as "extraction ran and found nothing"
            when really extraction was never attempted. %>
        <% if document.document_type.present? && document.classification_confirmed? %>
          <% present(document, Kyc::DocumentValidityPresenter) do |vp| %>
            <%= render "kyc/documents/validity_status", presenter: vp %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
