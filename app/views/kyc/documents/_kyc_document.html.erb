<div id="<%= dom_id(document) %>">
  <%= render "kyc/documents/kyc_document_metadata", document: document %>

  <% if document.dob_mismatch_kyc_principal && viewer_can?(document, :resolve_dob_mismatch?) %>
    <div class="mt-2">
      <%= render "kyc/principal_match_overrides/mismatch", document: document,
            errors: local_assigns[:override_errors] %>
    </div>
  <% end %>

  <% if document.validity_dates.present? && viewer_can?(document, :confirm_dates?) %>
    <% present(document, Kyc::DocumentDateConfirmationPresenter) do |presenter| %>
      <div class="mt-2 space-y-2">
        <% presenter.date_roles.each do |date_role| %>
          <%= render "kyc/document_date_confirmations/date_confirmation",
                document: document, date_role: date_role, presenter: presenter,
                errors: (local_assigns[:errored_role] == date_role ? local_assigns[:errors] : nil) %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
