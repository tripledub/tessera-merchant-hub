<%# MH-322: distinct id from the wrapping turbo-frame (see _kyc_document_row.html.erb),
    which shares the plain dom_id(document). turbo_stream.replace(dom_id(document), ...)
    would otherwise resolve to the FIRST element with that id — the frame — replacing it
    wholesale and destroying data-document-row, the anchor document_panels_controller.js
    needs to relocate the row between Documents-tab panels. Controllers doing that replace
    target "#{dom_id(document)}_content" instead. %>
<div id="<%= dom_id(document) %>_content">
  <%= render "kyc/documents/kyc_document_metadata", document: document %>

  <% if document.dob_mismatch_kyc_principal && viewer_can?(document, :resolve_dob_mismatch?) %>
    <div class="mt-2">
      <%= render "kyc/principal_match_overrides/mismatch", document: document,
            errors: local_assigns[:override_errors] %>
    </div>
  <% end %>

  <%# MH-322: date confirmation moved into a modal, opened from the row's
      overflow menu (kyc/documents/_kyc_document_metadata.html.erb) instead of
      always rendering inline here. See kyc/document_date_confirmations/_modal. %>
</div>
