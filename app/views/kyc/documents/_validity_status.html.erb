<div class="space-y-1.5">
  <div class="flex flex-wrap items-center gap-2" data-testid="document-validity-status">
    <%# MH-322: policy version dropped from this line — not useful to a reviewer. %>
    <%= presenter.outcome_badge %>
    <% if presenter.reason_text %>
      <span class="text-gray-500 dark:text-gray-400"><%= presenter.reason_text %></span>
    <% end %>
  </div>

  <% if presenter.replacement_requirement %>
    <%= render "kyc/documents/replacement_progress", presenter: presenter %>
  <% end %>

  <% if presenter.confirmation_history.any? %>
    <%= render "kyc/documents/confirmation_history", presenter: presenter %>
  <% end %>
</div>
