<% present(kyc_principal, Kyc::PrincipalPresenter) do |p| %>
  <div id="<%= dom_id(kyc_principal, :address_card) %>" class="card">
    <h2 class="mb-4 text-xs font-semibold uppercase tracking-wider text-gray-500">
      <%= t('kyc.principals.show.sections.address') %>
    </h2>
    <% if p.address_lines.any? %>
      <address class="not-italic text-theme-sm text-gray-900 dark:text-white/90 space-y-0.5">
        <% p.address_lines.each do |line| %>
          <p><%= line %></p>
        <% end %>
      </address>
    <% else %>
      <p class="text-theme-sm text-gray-400 italic"><%= t('kyc.principals.show.not_provided') %></p>
    <% end %>
  </div>
<% end %>
