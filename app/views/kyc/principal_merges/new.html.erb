<turbo-frame id="merge-principal-modal">
  <div data-controller="modal" data-modal-frame-value="merge-principal-modal"
       data-action="keydown.esc@window->modal#close"
       class="fixed inset-0 z-50 flex items-center justify-center">
    <div data-action="click->modal#close" class="absolute inset-0 bg-gray-900/50 backdrop-blur-sm"></div>
    <div class="relative z-10 w-full max-w-lg rounded-2xl border border-gray-200 bg-white p-6 shadow-xl">
      <div class="mb-5 flex items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900"><%= t('.title', name: kyc_principal.name) %></h2>
        <button type="button" data-action="click->modal#close"
                class="text-gray-400 hover:text-gray-600 transition">
          <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M5.293 5.293a1 1 0 0 1 1.414 0L12 10.586l5.293-5.293a1 1 0 1 1 1.414 1.414L13.414 12l5.293 5.293a1 1 0 0 1-1.414 1.414L12 13.414l-5.293 5.293a1 1 0 0 1-1.414-1.414L10.586 12 5.293 6.707a1 1 0 0 1 0-1.414z"/>
          </svg>
        </button>
      </div>

      <% if @error %>
        <p class="mb-4 text-theme-sm text-error-500"><%= @error %></p>
      <% end %>

      <% if @candidates.empty? %>
        <p class="text-theme-sm text-gray-500 italic"><%= t('.empty') %></p>
      <% else %>
        <ul id="merge-candidates-list" class="divide-y divide-gray-100 max-h-80 overflow-y-auto">
          <% @candidates.each do |candidate| %>
            <li class="flex items-center justify-between py-3">
              <div class="min-w-0">
                <p class="text-theme-sm font-medium text-gray-900 truncate"><%= candidate.name %></p>
                <p class="text-xs text-gray-400"><%= t("applicants.show.principals.roles.#{candidate.role}") %></p>
              </div>
              <%= button_to t('.merge'), kyc_principal_merge_path(kyc_principal), params: { loser_id: candidate.id },
                    method: :post, form: { data: { turbo_frame: "_top" } },
                    data: { turbo_confirm: t('.merge_confirm', name: candidate.name, into: kyc_principal.name) },
                    class: "btn-secondary flex-shrink-0 py-1 px-3 text-xs" %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>
</turbo-frame>
