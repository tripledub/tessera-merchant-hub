<% content_for :title, t("applicant_invitations.create.title") %>

<div class="card max-w-2xl" data-controller="clipboard">
  <h1 class="mb-2 text-xl font-semibold text-gray-900 dark:text-white/90"><%= t("applicant_invitations.create.title") %></h1>
  <p class="mb-6 text-sm text-gray-500 dark:text-gray-400"><%= t("applicant_invitations.create.subtitle", email: invitation.email) %></p>

  <div class="rounded-lg bg-gray-100 p-4 font-mono text-sm break-all dark:bg-gray-800" data-clipboard-target="source"><%= @invitation_url %></div>
  <div class="mt-4 flex items-center gap-3">
    <button type="button" class="btn-primary" data-action="clipboard#copy"><%= t("applicant_invitations.create.copy") %></button>
    <span class="text-sm text-success-600" data-clipboard-target="feedback"></span>
    <%= link_to t("applicant_invitations.create.done"), applicant_path(invitation.applicant), class: "btn-secondary" %>
  </div>
</div>
