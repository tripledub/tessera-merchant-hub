<% if policy(applicant).destroy? && applicant_delete_enabled? %>
  <%= button_to applicant_path(applicant), method: :delete,
        class: "inline-flex items-center gap-1.5 rounded-lg border border-error-300 bg-white px-3 py-2 text-theme-sm font-medium text-error-600 shadow-theme-xs hover:bg-error-50 dark:border-error-800 dark:bg-gray-900 dark:text-error-400 dark:hover:bg-error-500/10",
        data: {
          turbo_confirm: t("applicants.delete.confirm", name: applicant.name),
          confirm_required_text: applicant.name,
          confirm_input_label: t("applicants.delete.confirm_input_label")
        } do %>
    <%= t("applicants.delete.button") %>
  <% end %>
<% end %>
