<div class="mb-4 flex items-center justify-between">
  <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-500">
    <%= t('applicants.show.sections.domains') %>
  </h2>
  <% if policy(ApplicantDomain).new? %>
    <%= link_to t('applicants.show.add_domain'), new_applicant_kyc_applicant_domain_path(applicant),
          class: "btn-secondary",
          data: { turbo_frame: "applicant-domain-modal" } %>
  <% end %>
</div>

<table class="w-full text-left text-theme-sm">
  <thead>
    <tr class="border-b border-gray-200 dark:border-gray-800">
      <th class="py-2 pr-4 font-medium text-gray-500 dark:text-gray-400"><%= t('applicants.show.domains.table.name') %></th>
      <th class="px-4 py-2 font-medium text-gray-500 dark:text-gray-400"><%= t('applicants.show.domains.table.status') %></th>
      <th class="px-4 py-2 font-medium text-gray-500 dark:text-gray-400"><%= t('applicants.show.domains.table.actions') %></th>
    </tr>
  </thead>
  <tbody id="applicant-domains-list" class="divide-y divide-gray-100 dark:divide-gray-800">
    <% if @applicant_domains.empty? %>
      <tr id="applicant-domains-empty">
        <td colspan="3" class="py-4 text-theme-sm text-gray-500"><%= t('applicants.show.domains.empty') %></td>
      </tr>
    <% else %>
      <%= render partial: "kyc/applicant_domains/domain_row", collection: @applicant_domains, as: :applicant_domain %>
    <% end %>
  </tbody>
</table>
