<%= form_with model: applicant, url: applicants_path, class: "space-y-4" do |f| %>
  <%= render "shared/error_messages", object: applicant %>

  <div>
    <%= f.label :name, t("applicants.form.fields.name"), class: "form-label" %>
    <%= f.text_field :name, class: "form-input", required: true %>
  </div>

  <div>
    <%= f.label :company_number, t(".fields.company_number"), class: "form-label" %>
    <%= f.text_field :company_number, class: "form-input", placeholder: t(".fields.company_number_placeholder") %>
  </div>

  <div>
    <%= f.label :sector, t("applicants.form.fields.sector"), class: "form-label" %>
    <%= f.select :sector, Applicant.sectors.keys.map { |sector| [t("applicants.sectors.#{sector}"), sector] }, {}, class: "form-input" %>
  </div>

  <div id="registry_preview"></div>

  <div class="flex gap-3 pt-2">
    <%= f.button t(".lookup_button"), formaction: registry_preview_applicants_path, formmethod: :post,
          formnovalidate: true, name: nil, class: "btn-secondary" %>
    <%= f.submit t(".submit"), class: "btn-primary" %>
    <%= link_to t("applicants.form.cancel"), applicants_path, class: "btn-secondary" %>
  </div>
<% end %>
