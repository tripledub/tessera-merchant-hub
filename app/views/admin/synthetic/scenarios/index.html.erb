<% content_for :title, t('.page_title') %>

<div class="mb-6">
  <h1 class="text-xl font-semibold text-gray-900 dark:text-white/90"><%= t('.title') %></h1>
  <p class="mt-1 max-w-2xl text-theme-sm text-gray-500 dark:text-gray-400"><%= t('.subtitle') %></p>
</div>

<% if @scenarios.empty? %>
  <p id="synthetic-scenarios-empty" class="text-theme-sm text-gray-400 italic"><%= t('.empty') %></p>
<% else %>
  <div class="space-y-4">
    <% @scenarios.each do |scenario| %>
      <div class="card">
        <div class="mb-3 flex items-start justify-between gap-4">
          <div>
            <h2 class="text-base font-semibold text-gray-900 dark:text-white/90"><%= scenario.title %></h2>
            <p class="text-xs text-gray-400"><%= t('.company_number', number: scenario.company_number) %></p>
          </div>
          <%= link_to t('.download'), download_admin_synthetic_scenario_path(scenario.id), class: "btn-secondary flex-shrink-0" %>
        </div>

        <p class="mb-3 text-theme-sm text-gray-600 dark:text-gray-300"><%= scenario.ground_truth %></p>

        <div class="flex flex-wrap items-center gap-2 text-xs text-gray-400">
          <span><%= t('.qase_cases') %>:</span>
          <% scenario.qase_cases.each do |case_id| %>
            <span class="badge badge-gray"><%= case_id %></span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
