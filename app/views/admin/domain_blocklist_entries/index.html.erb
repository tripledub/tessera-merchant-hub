<% content_for :title, t('.page_title') %>

<div class="mb-6">
  <h1 class="text-xl font-semibold text-gray-900 dark:text-white/90"><%= t('.title') %></h1>
  <p class="mt-1 max-w-3xl text-theme-sm text-gray-500 dark:text-gray-400"><%= t('.subtitle') %></p>
</div>

<div class="card mb-6 max-w-xl">
  <%= form_with model: @entry, url: admin_domain_blocklist_entries_path, class: "space-y-3" do |f| %>
    <%= render "shared/error_messages", object: @entry %>

    <div>
      <%= f.label :name, t('.form.name'), class: "form-label" %>
      <div class="flex gap-3">
        <%= f.text_field :name, class: "form-input", required: true, placeholder: "example.com", autocomplete: "off" %>
        <%= f.submit t('.form.submit'), class: "btn-primary shrink-0" %>
      </div>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400"><%= t('.form.hint') %></p>
    </div>
  <% end %>
</div>

<div class="overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-white/[0.05] dark:bg-white/[0.03]">
  <table class="w-full text-left text-theme-sm">
    <thead>
      <tr class="border-b border-gray-100 dark:border-white/[0.05]">
        <th class="px-5 py-3 font-medium text-gray-500 dark:text-gray-400"><%= t('.table.name') %></th>
        <th class="px-5 py-3 font-medium text-gray-500 dark:text-gray-400"><%= t('.table.added_by') %></th>
        <th class="px-5 py-3 font-medium text-gray-500 dark:text-gray-400"><%= t('.table.added_on') %></th>
        <th class="px-5 py-3 font-medium text-gray-500 dark:text-gray-400"><%= t('.table.actions') %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100 dark:divide-white/[0.05]">
      <% if @entries.empty? %>
        <tr>
          <td colspan="4" class="px-5 py-10 text-center text-theme-sm text-gray-500"><%= t('.table.empty') %></td>
        </tr>
      <% else %>
        <% @entries.each do |entry| %>
          <tr class="hover:bg-gray-50 dark:hover:bg-white/[0.02]">
            <td class="px-5 py-4 font-medium text-gray-800 dark:text-white/90"><%= entry.name %></td>
            <td class="px-5 py-4 text-gray-500 dark:text-gray-400"><%= entry.created_by&.email || t('.table.system') %></td>
            <td class="px-5 py-4 text-gray-500 dark:text-gray-400"><%= l(entry.created_at.to_date, format: :long) %></td>
            <td class="px-5 py-4">
              <%= button_to admin_domain_blocklist_entry_path(entry), method: :delete,
                    title: t('.table.remove'),
                    "aria-label": t('.table.remove'),
                    data: { turbo_confirm: t('.table.remove_confirm', name: entry.name) },
                    class: "text-gray-400 hover:text-error-500 dark:hover:text-error-400" do %>
                <svg class="fill-current" width="18" height="18" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M7.04142 4.29199C7.04142 3.04935 8.04878 2.04199 9.29142 2.04199H11.7081C12.9507 2.04199 13.9581 3.04935 13.9581 4.29199V4.54199H16.1252H17.166C17.5802 4.54199 17.916 4.87778 17.916 5.29199C17.916 5.70621 17.5802 6.04199 17.166 6.04199H16.8752V8.74687V13.7469V16.7087C16.8752 17.9513 15.8678 18.9587 14.6252 18.9587H6.37516C5.13252 18.9587 4.12516 17.9513 4.12516 16.7087V13.7469V8.74687V6.04199H3.8335C3.41928 6.04199 3.0835 5.70621 3.0835 5.29199C3.0835 4.87778 3.41928 4.54199 3.8335 4.54199H4.87516H7.04142V4.29199ZM15.3752 13.7469V8.74687V6.04199H13.9581H13.2081H7.79142H7.04142H5.62516V8.74687V13.7469V16.7087C5.62516 17.1229 5.96095 17.4587 6.37516 17.4587H14.6252C15.0394 17.4587 15.3752 17.1229 15.3752 16.7087V13.7469ZM8.54142 4.54199H12.4581V4.29199C12.4581 3.87778 12.1223 3.54199 11.7081 3.54199H9.29142C8.87721 3.54199 8.54142 3.87778 8.54142 4.29199V4.54199ZM8.8335 8.50033C9.24771 8.50033 9.5835 8.83611 9.5835 9.25033V14.2503C9.5835 14.6645 9.24771 15.0003 8.8335 15.0003C8.41928 15.0003 8.0835 14.6645 8.0835 14.2503V9.25033C8.0835 8.83611 8.41928 8.50033 8.8335 8.50033ZM12.9168 9.25033C12.9168 8.83611 12.581 8.50033 12.1668 8.50033C11.7526 8.50033 11.4168 8.83611 11.4168 9.25033V14.2503C11.4168 14.6645 11.7526 15.0003 12.1668 15.0003C12.581 15.0003 12.9168 14.6645 12.9168 14.2503V9.25033Z" fill=""/>
                </svg>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
