<% content_for :title, "KYC onboarding" %>

<%= turbo_stream_from @onboarding_session %>

<section
  class="flex h-[calc(100dvh-5.5rem-1px)] lg:h-[calc(100dvh-6rem-1px)] w-full flex-col overflow-hidden rounded-kyn-lg border border-kyn-border bg-kyn-surface"
  data-controller="onboarding-chat"
  data-onboarding-chat-session-id-value="<%= @onboarding_session.id %>"
  data-onboarding-chat-token-value="<%= @cable_token %>"
  data-onboarding-chat-uploading-template-value="<%= t("onboarding.composer.uploading", names: "%{names}") %>">
  <%= render "onboarding/conversations/progress", session: @onboarding_session %>

  <div
    id="onboarding_messages"
    class="flex-1 space-y-4 overflow-y-auto bg-kyn-surface px-4 py-4 sm:px-6"
    data-onboarding-chat-target="messages">
    <% if @messages.any? %>
      <%= render partial: "onboarding/conversations/message", collection: @messages, as: :message %>
      <% if @resume_notice %>
        <%= render "onboarding/conversations/message",
              message: @onboarding_session.onboarding_messages.build(
                role: :bot,
                content: @resume_notice,
                stage: @onboarding_session.current_stage,
                created_at: Time.current
              ) %>
      <% end %>
    <% elsif @company_confirmation %>
      <%= render "onboarding/conversations/message",
            message: @onboarding_session.onboarding_messages.build(
              role: :bot,
              content: @company_confirmation,
              stage: @onboarding_session.current_stage,
              created_at: Time.current
            ) %>
      <div class="flex flex-wrap justify-start gap-3" data-testid="company-confirmation">
        <%= button_to "Yes, that's right", portal_onboarding_company_confirmation_path,
              params: { answer: "yes" }, method: :post,
              class: "kyn-btn-primary w-auto! min-h-11! px-4!",
              data: { testid: "company-confirmation-yes" } %>
        <%= button_to "No, start again", portal_onboarding_company_confirmation_path,
              params: { answer: "no" }, method: :post,
              class: "kyn-btn-secondary w-auto! min-h-11! px-4!",
              data: { testid: "company-confirmation-no" } %>
      </div>
    <% else %>
      <%= render "onboarding/conversations/message",
            message: @onboarding_session.onboarding_messages.build(
              role: :bot,
              content: "Welcome. I’ll guide you through the KYC onboarding questions and keep track of your progress as we go. To begin, please tell us the name of your business.",
              stage: @onboarding_session.current_stage,
              created_at: Time.current
            ) %>
    <% end %>
  </div>

  <div
    id="onboarding_typing"
    class="hidden px-4 pb-3 sm:px-6"
    aria-live="polite"
    data-onboarding-chat-target="typing">
    <div class="kyn-bubble kyn-bubble-assistant inline-flex items-center gap-1.5">
      <span class="kyn-typing-dot"></span>
      <span class="kyn-typing-dot"></span>
      <span class="kyn-typing-dot"></span>
      <span class="sr-only"><%= t("onboarding.conversations.typing_label") %></span>
    </div>
  </div>

  <%= form_with url: portal_onboarding_documents_path,
        method: :post,
        multipart: true,
        class: "hidden",
        data: {
          turbo_stream: true,
          action: "turbo:submit-start->onboarding-chat#uploadStart turbo:submit-end->onboarding-chat#uploadEnd"
        } do %>
    <input
      id="onboarding_document_upload"
      type="file"
      name="kyc_document[files][]"
      multiple
      accept="image/*,application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,text/csv"
      data-onboarding-chat-target="uploadInput"
      data-action="change->onboarding-chat#submitUpload" />
  <% end %>

  <% if @onboarding_session.document_collection? %>
    <%= render "onboarding/conversations/document_checklist", outstanding_items: @outstanding_items %>
  <% end %>
  <%= render "onboarding/conversations/document_status_notices", onboarding_session: @onboarding_session %>
  <%= render "onboarding/conversations/composer", session: @onboarding_session %>
</section>
