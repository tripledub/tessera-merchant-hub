<% present(onboarding_session, OnboardingDocumentValidityPresenter) do |dvp| %>
  <% notices = dvp.notices %>
  <% if notices.any? %>
    <div
      id="onboarding_document_status_notices"
      class="space-y-2 border-t border-gray-200 bg-gray-50 px-4 py-3 dark:border-gray-800 dark:bg-gray-950/30 sm:px-6"
      data-testid="document-status-notices">
      <% notices.each do |notice| %>
        <p class="text-sm text-gray-700 dark:text-gray-200"><%= notice.message %></p>
      <% end %>
    </div>
  <% end %>
<% end %>
