<div
  id="onboarding_document_checklist"
  class="<%= "hidden" if outstanding_items.empty? %> space-y-2 border-t border-gray-200 bg-gray-50 px-4 py-3 dark:border-gray-800 dark:bg-gray-950/30 sm:px-6">
  <% outstanding_items.each do |item| %>
    <div class="flex items-center justify-between gap-3 text-sm text-gray-700 dark:text-gray-200">
      <span><%= item["label"] %></span>
      <%= button_to "Can't upload now", portal_onboarding_document_deferrals_path,
            params: { index: item["index"] },
            class: "rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-600 transition hover:border-brand-500 hover:text-brand-600 dark:border-gray-700 dark:text-gray-300",
            form_class: "inline-flex shrink-0",
            aria: { label: "Can't upload #{item["label"]} now" },
            data: { turbo_stream: true, testid: "defer-document-button" } %>
    </div>
  <% end %>
</div>
