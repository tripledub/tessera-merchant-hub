<div
  id="onboarding_document_checklist"
  class="<%= "hidden" if outstanding_items.empty? %> space-y-2 border-t border-kyn-border bg-kyn-surface px-4 py-3 sm:px-6">
  <% outstanding_items.each do |item| %>
    <div class="flex items-center justify-between gap-3 text-sm text-kyn-navy">
      <span class="flex min-w-0 items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5 shrink-0 text-kyn-slate" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Zm0 0v5h5"/>
        </svg>
        <span class="min-w-0"><%= item["label"] %></span>
      </span>
      <%= button_to "Can't upload now", portal_onboarding_document_deferrals_path,
            params: { index: item["index"] },
            class: "kyn-btn-secondary min-h-11! w-auto! px-4! text-[13px]!",
            form_class: "inline-flex shrink-0",
            aria: { label: "Can't upload #{item["label"]} now" },
            data: { turbo_stream: true, testid: "defer-document-button" } %>
    </div>
  <% end %>
</div>
