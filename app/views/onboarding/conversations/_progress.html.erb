<% present(session, OnboardingSessionPresenter) do |presenter| %>
  <% percent = presenter.progress_percentage %>

  <div
    id="onboarding_progress"
    class="px-4 pb-3 pt-4 sm:px-6"
    data-testid="onboarding-progress">
    <div
      class="kyn-progress"
      role="progressbar"
      aria-label="<%= t("onboarding.conversations.progress.label") %>"
      aria-valuenow="<%= percent %>"
      aria-valuemin="0"
      aria-valuemax="100">
      <div class="kyn-progress-fill" style="width: <%= percent %>%"></div>
    </div>
    <p class="mt-2 text-[13px] font-medium text-kyn-slate"><%= t("onboarding.conversations.progress.completed", percent: percent) %></p>
  </div>
<% end %>
