<% applicant_message = message.applicant? %>

<div class="flex <%= applicant_message ? "justify-end" : "justify-start" %>">
  <div class="max-w-[85%] sm:max-w-[75%]">
    <div class="kyn-bubble <%= applicant_message ? "kyn-bubble-applicant" : "kyn-bubble-assistant chat-prose" %>">
      <% if applicant_message %>
        <%= simple_format(message.content, {}, wrapper_tag: "div") %>
      <% else %>
        <%= render_markdown(message.content) %>
      <% end %>
    </div>
    <% if message.created_at.present? %>
      <p class="mt-1 px-1 text-xs text-kyn-slate <%= applicant_message ? "text-right" : "" %>">
        <%= l(message.created_at, format: :short) %>
      </p>
    <% end %>
  </div>
</div>
