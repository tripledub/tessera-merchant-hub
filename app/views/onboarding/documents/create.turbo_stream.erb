<%= turbo_stream.update "onboarding_upload_status" do %>
  <p role="status" class="text-xs <%= @type == :success ? "text-kyn-success" : "text-kyn-error" %>">
    <%= @message %>
  </p>
  <% if @results.present? %>
    <ul class="mt-1 space-y-0.5">
      <% @results.each do |result| %>
        <li class="text-xs <%= result.success? ? "text-kyn-success" : "text-kyn-error" %>">
          <span class="font-medium"><%= result.filename %></span>
          <%= result.success? ? "— uploaded" : "— #{result.error}" %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<% if @bot_message %>
  <%= turbo_stream.append "onboarding_messages" do %>
    <%= render "onboarding/conversations/message", message: @bot_message %>
  <% end %>
<% end %>
