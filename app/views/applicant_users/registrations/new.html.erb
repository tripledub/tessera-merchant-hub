<%= render "layouts/applicant_auth_card", title: t("applicant_users.registrations.new.title") do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
        html: { data: { controller: "form-validation", action: "submit->form-validation#submitForm" } }) do |f| %>
    <%= hidden_field_tag :invitation_token, params[:invitation_token] %>
    <div class="space-y-5">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div class="kyn-field" data-field>
          <%= f.label :first_name, t("applicant_users.registrations.new.first_name"), class: "kyn-label" %>
          <%= f.text_field :first_name, autofocus: true, autocomplete: "given-name", required: true,
                class: kyn_field_class(resource, :first_name), placeholder: "First name",
                **kyn_field_aria(resource, :first_name, kyn_field_error_id(resource_name, :first_name)) %>
          <%= kyn_field_error(resource, :first_name, id: kyn_field_error_id(resource_name, :first_name)) %>
        </div>
        <div class="kyn-field" data-field>
          <%= f.label :last_name, t("applicant_users.registrations.new.last_name"), class: "kyn-label" %>
          <%= f.text_field :last_name, autocomplete: "family-name", required: true,
                class: kyn_field_class(resource, :last_name), placeholder: "Last name",
                **kyn_field_aria(resource, :last_name, kyn_field_error_id(resource_name, :last_name)) %>
          <%= kyn_field_error(resource, :last_name, id: kyn_field_error_id(resource_name, :last_name)) %>
        </div>
      </div>
      <div class="kyn-field" data-field>
        <%= f.label :email, t("applicant_users.registrations.new.email"), class: "kyn-label" %>
        <%= f.email_field :email, autocomplete: "email", required: true, readonly: true,
              class: "#{kyn_field_class(resource, :email)} read-only:bg-kyn-bg read-only:text-kyn-slate",
              placeholder: "you@example.com",
              **kyn_field_aria(resource, :email, kyn_field_error_id(resource_name, :email)) %>
        <%= kyn_field_error(resource, :email, id: kyn_field_error_id(resource_name, :email)) %>
      </div>
      <%= render "applicant_users/shared/password_field",
            form: f, resource: resource, attribute: :password,
            label: t("applicant_users.registrations.new.password"),
            autocomplete: "new-password", required: true,
            minlength: @minimum_password_length || 6,
            hint: (t("applicant_users.shared.password_field.minimum", count: @minimum_password_length) if @minimum_password_length) %>
      <%= render "applicant_users/shared/password_field",
            form: f, resource: resource, attribute: :password_confirmation,
            label: t("applicant_users.registrations.new.password_confirmation"),
            autocomplete: "new-password", required: true, toggle: false %>
      <%= f.submit t("applicant_users.registrations.new.submit"), class: "kyn-btn-primary" %>
    </div>
  <% end %>
  <p class="mt-4 text-center text-sm text-kyn-slate">
    <%= t("applicant_users.registrations.new.already_have_account") %>
    <%= link_to t("applicant_users.registrations.new.sign_in_link"), new_session_path(resource_name),
          class: "kyn-link" %>
  </p>
<% end %>
