<%# Password field for the applicant auth pages, with an optional show/hide
    toggle (a 44px button with an accessible name and aria-pressed).
    locals: form, resource, attribute, label (optional), autocomplete, required,
            minlength, autofocus, hint, toggle (default true) %>
<% label_text = local_assigns[:label] || resource.class.human_attribute_name(attribute) %>
<% error_id = kyn_field_error_id(resource_name, attribute) %>
<% toggle = local_assigns.fetch(:toggle, true) %>
<div class="kyn-field" data-field>
  <%= form.label attribute, label_text, class: "kyn-label" %>
  <% if local_assigns[:hint].present? %>
    <p class="-mt-1 mb-1.5 text-xs text-kyn-slate"><%= hint %></p>
  <% end %>
  <div class="relative"
       <% if toggle %>
         data-controller="password-toggle"
         data-password-toggle-show-label-value="<%= t(".show") %>"
         data-password-toggle-hide-label-value="<%= t(".hide") %>"
       <% end %>>
    <%= form.password_field attribute,
          autocomplete: local_assigns[:autocomplete],
          required: local_assigns.fetch(:required, false),
          minlength: local_assigns[:minlength],
          autofocus: local_assigns.fetch(:autofocus, false),
          placeholder: "••••••••",
          class: [ kyn_field_class(resource, attribute), ("pr-12" if toggle) ].compact.join(" "),
          data: (toggle ? { password_toggle_target: "input" } : {}),
          **kyn_field_aria(resource, attribute, error_id) %>
    <% if toggle %>
      <button type="button"
              data-action="password-toggle#toggle"
              data-password-toggle-target="button"
              aria-pressed="false"
              aria-label="<%= t(".show") %>"
              class="absolute inset-y-0 right-0 flex w-12 items-center justify-center rounded-kyn-md text-kyn-slate hover:text-kyn-navy focus-visible:ring-[3px] focus-visible:ring-kyn-primary/30 focus-visible:outline-none">
        <svg data-password-toggle-target="showIcon" class="hidden h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <svg data-password-toggle-target="hideIcon" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88"/>
        </svg>
      </button>
    <% end %>
  </div>
  <%= kyn_field_error(resource, attribute, id: error_id) %>
</div>
