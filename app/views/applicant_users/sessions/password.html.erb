<%= render "layouts/applicant_auth_card", title: t("applicant_users.sessions.password.title") do %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="space-y-5">
      <div class="kyn-field" data-field>
        <%= f.label :email, class: "kyn-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "kyn-input", placeholder: "you@example.com" %>
      </div>
      <%= render "applicant_users/shared/password_field",
            form: f, resource: resource, attribute: :password, autocomplete: "current-password" %>
      <% if devise_mapping.rememberable? %>
        <%= f.label :remember_me, class: "kyn-check-label" do %>
          <%= f.check_box :remember_me, class: "kyn-checkbox" %>
          <span><%= resource.class.human_attribute_name(:remember_me) %></span>
        <% end %>
      <% end %>
      <%= f.submit t("applicant_users.sessions.password.submit"), class: "kyn-btn-primary" %>
    </div>
  <% end %>
  <div class="mt-4 flex flex-col items-center">
    <%= link_to t("applicant_users.sessions.password.use_code"), new_applicant_user_session_path,
          class: "kyn-link inline-flex min-h-[44px] items-center text-sm" %>
    <% if devise_mapping.recoverable? && controller_name != "passwords" %>
      <%= link_to t("applicant_users.sessions.password.forgot_password"), new_password_path(resource_name),
            class: "kyn-link inline-flex min-h-[44px] items-center text-sm" %>
    <% end %>
    <% if devise_mapping.confirmable? %>
      <%= link_to t("applicant_users.sessions.password.resend_confirmation"), new_confirmation_path(resource_name),
            class: "kyn-link inline-flex min-h-[44px] items-center text-sm" %>
    <% end %>
  </div>
<% end %>
