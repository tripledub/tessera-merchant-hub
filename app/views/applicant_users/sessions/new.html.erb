<%# Welcome back (Auth / 4): ask for a one-time code. The same page whatever the
    address, and it says nothing about accounts (MH-406). %>
<% content_for :title, t("applicant_users.sessions.code.page_title") %>

<%= render "layouts/applicant_auth_card", title: t("applicant_users.sessions.code.title"),
      note: t("applicant_users.sessions.code.invited") do %>
  <p class="-mt-3 mb-6 text-sm leading-[22px] text-kyn-slate"><%= t("applicant_users.sessions.code.intro") %></p>

  <%= form_with url: portal_sign_in_start_path, method: :post do %>
    <div class="space-y-4">
      <div class="kyn-field">
        <%= label_tag :email, t("applicant_users.sessions.code.email"), class: "kyn-label" %>
        <%= email_field_tag :email, params[:email].is_a?(String) ? params[:email] : nil,
              autofocus: true, required: true, autocomplete: "username email", placeholder: "you@company.com",
              class: "kyn-input", aria: { invalid: @email_error.present?.to_s, describedby: (@email_error ? "email-error" : nil) } %>
        <% if @email_error %>
          <p id="email-error" role="alert" class="mt-1.5 text-[13px] font-medium text-kyn-error"><%= t("applicant_users.sessions.code.invalid_email") %></p>
        <% end %>
      </div>
      <%= button_tag t("applicant_users.sessions.code.submit"), type: "submit", class: "kyn-btn-primary" %>
    </div>
  <% end %>

  <div class="mt-4 flex flex-col items-center">
    <%= link_to t("applicant_users.sessions.code.use_password"), applicant_user_password_sign_in_path,
          class: "inline-flex min-h-[44px] items-center text-sm text-kyn-slate hover:underline" %>
  </div>
<% end %>
