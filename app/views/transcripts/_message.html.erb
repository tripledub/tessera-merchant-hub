<% applicant_message = message.applicant? %>

<article class="flex <%= applicant_message ? "justify-end" : "justify-start" %>">
  <div class="max-w-[85%] sm:max-w-[72%]">
    <p class="mb-1 text-xs font-medium text-gray-500 <%= applicant_message ? "text-right" : "" %>">
      <%= applicant_message ? t(".applicant") : t(".chatbot") %>
    </p>
    <div class="rounded-2xl px-4 py-3 text-sm leading-6 <%= applicant_message ? "rounded-br-sm bg-brand-500 text-white" : "rounded-bl-sm bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-100" %>">
      <% if applicant_message %>
        <%= simple_format(message.content, {}, wrapper_tag: "div") %>
      <% else %>
        <div class="chat-prose"><%= render_markdown(message.content) %></div>
      <% end %>
    </div>
    <time datetime="<%= message.created_at.iso8601 %>" class="mt-1 block text-xs text-gray-500 <%= applicant_message ? "text-right" : "" %>">
      <%= l(message.created_at, format: :short) %>
    </time>
  </div>
</article>
