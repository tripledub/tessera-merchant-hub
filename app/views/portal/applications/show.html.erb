<% content_for :title, t("portal.applications.title") %>
<% content_for :applicant_width, "wide" %>

<% present(@application) do |application_presenter| %>
  <% steps = application_presenter.steps %>
  <% number = steps.index { |step| step[:key] == @step } + 1 %>
  <% step_of = t("portal.applications.step_of", number: number, total: steps.size) %>
  <% step_title = t("portal.applications.steps.#{@step}") %>
  <% percent = application_presenter.progress_percentage %>

  <div class="mx-auto max-w-5xl">
    <%# Phones: one compact bar, "Step N of 10 · All steps", that opens the full list.
        A native <details>, so it needs no JavaScript and closes on each step change. %>
    <h1 class="sr-only lg:hidden"><%= step_title %></h1>
    <details class="group mb-5 lg:hidden" data-testid="steps-bar">
      <summary class="block min-h-11 cursor-pointer list-none rounded-kyn-md outline-none focus-visible:ring-[3px] focus-visible:ring-kyn-primary/30 [&::-webkit-details-marker]:hidden">
        <span class="flex items-center justify-between gap-3">
          <span class="text-xs font-semibold text-kyn-slate"><%= step_of %></span>
          <span class="text-[13px] font-semibold text-kyn-primary-text">
            <span class="group-open:hidden"><%= t("portal.applications.all_steps") %></span>
            <span class="hidden group-open:inline"><%= t("portal.applications.hide_steps") %></span>
          </span>
        </span>
        <span class="mt-1 block text-2xl font-bold text-kyn-navy" aria-hidden="true"><%= step_title %></span>
        <span class="kyn-progress mt-3 block" aria-hidden="true">
          <span class="kyn-progress-fill block" style="width: <%= percent %>%"></span>
        </span>
      </summary>
      <nav class="mt-4" aria-label="<%= t("portal.applications.progress") %>">
        <%= render "portal/applications/steps_list", steps: steps, current_key: @step %>
        <p class="mt-3 text-xs text-kyn-slate"><%= t("portal.applications.steps_note") %></p>
      </nav>
    </details>

    <div class="mb-6 hidden lg:block">
      <p class="text-xs font-semibold text-kyn-slate"><%= step_of %></p>
      <h1 class="mt-1 text-2xl font-bold text-kyn-navy"><%= step_title %></h1>
      <div class="kyn-progress mt-3" role="progressbar" aria-label="<%= t("portal.applications.progress") %>"
           aria-valuenow="<%= percent %>" aria-valuemin="0" aria-valuemax="100">
        <div class="kyn-progress-fill" style="width: <%= percent %>%"></div>
      </div>
    </div>

    <div class="lg:grid lg:grid-cols-[18rem_1fr] lg:items-start lg:gap-8">
      <aside class="hidden lg:block" data-testid="steps-sidebar">
        <nav aria-label="<%= t("portal.applications.progress") %>">
          <%= render "portal/applications/steps_list", steps: steps, current_key: @step %>
        </nav>
        <p class="mt-3 text-xs text-kyn-slate"><%= t("portal.applications.steps_note") %></p>
      </aside>

      <%# The review step is a stack of its own sections, so nothing wraps it. %>
      <section class="<%= "kyn-card" unless @step == "review" %>">
        <% if @step == "company" %>
          <%= render "portal/applications/company_fields", application: @application %>
        <% elsif @step == "fulfilment" %>
          <%= render "portal/applications/fulfilment_fields", application: @application %>
        <% elsif @step == "currencies" %>
          <%= render "portal/applications/currency_fields", application: @application %>
        <% elsif @step == "processing" %>
          <%= render "portal/applications/processing_fields", application: @application %>
        <% elsif @step == "payments" %>
          <%= render "portal/applications/payment_fields", application: @application %>
        <% elsif @step == "descriptor" %>
          <%= render "portal/applications/descriptor_fields", application: @application %>
        <% elsif @step == "countries" %>
          <%= render "portal/applications/country_fields", application: @application %>
        <% elsif @step == "principals" %>
          <%= render "portal/applications/principal_fields", application: @application %>
        <% elsif @step == "review" %>
          <%= render "portal/applications/review", application: @application %>
        <% elsif @step == @application.current_step %>
          <p class="text-sm text-kyn-slate"><%= t("portal.applications.section_placeholder") %></p>
          <%= form_with url: portal_application_path, method: :patch, class: "mt-8" do %>
            <%= hidden_field_tag :step, @step %>
            <%= submit_tag t("portal.applications.continue"), class: "kyn-btn-primary sm:w-60" %>
          <% end %>
        <% else %>
          <p class="text-sm text-kyn-slate"><%= t("portal.applications.revisiting") %></p>
        <% end %>
      </section>
    </div>
  </div>
<% end %>
