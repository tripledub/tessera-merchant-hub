<%= form_with model: application, url: portal_application_path, method: :patch, class: "space-y-6",
      data: { controller: "form-validation", action: "submit->form-validation#submitForm" } do |form| %>
  <%= hidden_field_tag :step, "company" %>
  <%= render "portal/applications/error_summary", object: application %>

  <%= render "portal/applications/your_details_fields" %>

  <%= form.fields_for :applicant do |applicant_form| %>
    <%= applicant_form.hidden_field :id %>

    <div class="grid gap-4 sm:grid-cols-2">
      <div class="kyn-field">
        <%= applicant_form.label :company_name, t("portal.applications.company.company_name"), class: "kyn-label" %>
        <%# A business the PSP added has a name but no company name the applicant has declared: offer it (MH-415). %>
        <% prefilled_name = applicant_form.object.company_name.blank? && applicant_form.object.name.present? %>
        <%= applicant_form.text_field :company_name, required: true, class: "kyn-input",
              **(prefilled_name ? { value: applicant_form.object.name } : {}) %>
        <% if prefilled_name %>
          <p class="mt-1.5 text-[13px] text-kyn-slate"><%= t("portal.applications.company.company_name_prefilled") %></p>
        <% end %>
      </div>
      <div class="kyn-field">
        <%= applicant_form.label :company_number, t("portal.applications.company.company_number"), class: "kyn-label" %>
        <%= applicant_form.text_field :company_number, class: "kyn-input" %>
      </div>
    </div>

    <%= applicant_form.fields_for :primary_business_address do |address_form| %>
      <%= render "portal/applications/address_fields", form: address_form, title: t("portal.applications.company.registered_address") %>
    <% end %>

    <div data-controller="address-same-as">
      <label class="kyn-check-label">
        <%= check_box_tag "onboarding_application[trading_address_same_as_registered]", "1", @trading_address_same_as_registered,
              class: "kyn-checkbox", data: { "address-same-as-target": "checkbox", action: "change->address-same-as#toggle" } %>
        <%= t("portal.applications.company.trading_address_same_as_registered") %>
      </label>

      <div data-address-same-as-target="fields" class="mt-4">
        <%= applicant_form.fields_for :trading_address do |address_form| %>
          <%= render "portal/applications/address_fields", form: address_form, title: t("portal.applications.company.trading_address") %>
        <% end %>
      </div>
    </div>

    <fieldset>
      <legend class="kyn-label"><%= t("portal.applications.company.domains") %></legend>
      <%= render "shared/repeatable_fields/component",
            form: applicant_form,
            association: :applicant_domains,
            new_child: ApplicantDomain.new,
            fields_partial: "portal/applications/domain_fields",
            add_label: t("portal.applications.company.add_domain"),
            remove_label: t("portal.applications.company.remove_domain"),
            min: 0 %>
    </fieldset>

    <div class="kyn-field">
      <%= applicant_form.label :sector, t("portal.applications.company.sector"), class: "kyn-label" %>
      <%= applicant_form.select :sector,
            Applicant.sectors.keys.map { |sector| [t("applicants.sectors.#{sector}"), sector] },
            {}, class: "kyn-input" %>
    </div>
  <% end %>

  <div class="kyn-field">
    <%= form.label :eu_entity_details, t("portal.applications.company.eu_entity_details"), class: "kyn-label" %>
    <%= form.text_area :eu_entity_details, rows: 3, class: "kyn-input" %>
  </div>
  <div class="kyn-field">
    <%= form.label :referrer, t("portal.applications.company.referrer"), class: "kyn-label" %>
    <%= form.text_field :referrer, class: "kyn-input" %>
  </div>
  <div class="kyn-field">
    <%= form.label :business_model_description, t("portal.applications.company.business_model_description"), class: "kyn-label" %>
    <%= form.text_area :business_model_description, rows: 5, required: true, class: "kyn-input" %>
  </div>
  <div class="kyn-field">
    <%= form.label :test_login_details, t("portal.applications.company.test_login_details"), class: "kyn-label" %>
    <p class="mb-2 text-[13px] text-kyn-slate"><%= t("portal.applications.company.test_login_warning") %></p>
    <%= form.text_area :test_login_details, rows: 3, class: "kyn-input", autocomplete: "off" %>
  </div>
  <div class="kyn-field">
    <%= form.label :operating_licence, t("portal.applications.company.operating_licence"), class: "kyn-label" %>
    <%= form.text_area :operating_licence, rows: 3, required: true, class: "kyn-input" %>
  </div>

  <div class="flex justify-end">
    <%= form.submit t("portal.applications.continue"), class: "kyn-btn-primary sm:w-60" %>
  </div>
<% end %>
