<%# The applicant's own name (MH-407): optional, saved onto the signed-in user and
    used only to greet them. Sent apart from the company answers, as applicant_user[...]. %>
<%= fields_for :applicant_user, current_applicant_user do |user_form| %>
  <fieldset>
    <legend class="kyn-label"><%= t(".legend") %></legend>
    <p class="mb-3 text-[13px] text-kyn-slate"><%= t(".hint") %></p>
    <div class="grid gap-4 sm:grid-cols-2">
      <% %i[first_name last_name].each do |attribute| %>
        <div class="kyn-field">
          <%= user_form.label attribute, t(".#{attribute}"), class: "kyn-label" %>
          <%= user_form.text_field attribute, autocomplete: attribute == :first_name ? "given-name" : "family-name",
                maxlength: ApplicantUser::NAME_MAX_LENGTH, class: "kyn-input" %>
          <% current_applicant_user.errors[attribute].each do |message| %>
            <p class="form-error"><%= t(".#{attribute}") %> <%= message %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  </fieldset>
<% end %>
