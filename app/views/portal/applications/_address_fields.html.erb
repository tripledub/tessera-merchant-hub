<fieldset class="rounded-lg border border-gray-200 p-4">
  <legend class="px-1 text-sm font-semibold text-gray-900"><%= title %></legend>
  <%= form.hidden_field :id if form.object.persisted? %>
  <div class="grid gap-4 sm:grid-cols-2">
    <% %i[line1 line2 city postcode country].each do |field| %>
      <div class="<%= "sm:col-span-2" if field.in?(%i[line1 line2]) %>">
        <%= form.label field, t("portal.applications.company.address.#{field}"), class: "form-label" %>
        <%= form.text_field field, required: field.in?(%i[line1 city country]), class: "form-input" %>
        <% form.object.errors.full_messages_for(field).each do |message| %>
          <p class="form-error"><%= message %></p>
        <% end %>
      </div>
    <% end %>
  </div>
</fieldset>
