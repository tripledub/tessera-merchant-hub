<div class="kyn-field">
  <%= form.label :code, t("portal.applications.currencies.code"), class: "kyn-label" %>
  <%= form.text_field :code, required: true, maxlength: 3,
        placeholder: t("portal.applications.currencies.placeholder"), class: "kyn-input uppercase" %>
  <% form.object.errors.full_messages_for(:code).each do |message| %>
    <p class="form-error"><%= message %></p>
  <% end %>
</div>
