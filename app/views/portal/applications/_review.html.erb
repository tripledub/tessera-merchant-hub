<div class="space-y-4">
  <%= render "portal/applications/error_summary", object: application %>

  <% applicant = application.applicant %>
  <% trading_address_row = if applicant.trading_address_same_as_registered?
       [t("portal.applications.review.trading_address"), t("portal.applications.review.trading_address_same_as_registered")]
     else
       [t("portal.applications.review.trading_address"), format_review_address(applicant.trading_address)]
     end %>
  <% [
       ["company", [[t("portal.applications.company.company_name"), application.applicant.company_name],
                    [t("portal.applications.company.company_number"), application.applicant.company_number.presence || t("portal.applications.review.not_applicable")],
                    [t("portal.applications.review.registered_address"), format_review_address(applicant.primary_business_address)],
                    trading_address_row,
                    [t("portal.applications.company.business_model_description"), application.business_model_description]]],
       ["fulfilment", [[t("portal.applications.fulfilment.service_requirements"), application.service_requirements],
                       [t("portal.applications.fulfilment.integration_type"), application.integration_type]]],
       ["currencies", [[t("portal.applications.currencies.processing"), application.processing_currencies.map(&:code).join(", ")],
                       [t("portal.applications.currencies.settlement"), application.settlement_currencies.map(&:code).join(", ")]]],
       ["processing", [[t("portal.applications.processing.current_acquirer"), application.current_acquirer]]],
       ["payments", [[t("portal.applications.payments.shopping_cart_provider"), application.shopping_cart_provider]]],
       ["descriptor", [[t("portal.applications.descriptor.descriptor"), application.descriptor]]],
       ["countries", [[t("portal.applications.steps.countries"), application.target_country_names.join(", ")]]]
     ].each do |step, rows| %>
    <section class="kyn-card">
      <div class="flex items-center justify-between gap-4">
        <h3 class="text-lg font-bold text-kyn-navy"><%= t("portal.applications.steps.#{step}") %></h3>
        <%= link_to t("portal.applications.review.edit"), portal_application_path(step: step), class: "kyn-link inline-flex min-h-11 items-center px-1 text-[14px]" %>
      </div>
      <dl class="mt-4 space-y-3">
        <% rows.each do |label, value| %>
          <div>
            <dt class="text-[13px] text-kyn-slate"><%= label %></dt>
            <% if value.present? %>
              <dd class="text-[15px] text-kyn-navy"><%= value %></dd>
            <% else %>
              <dd class="text-[15px] font-semibold text-kyn-error" data-testid="review-missing">
                <%= t("portal.applications.review.missing") %>
                <%= link_to t("portal.applications.review.missing_hint"), portal_application_path(step: step), class: "underline" %>
              </dd>
            <% end %>
          </div>
        <% end %>
      </dl>
    </section>
  <% end %>

  <section class="kyn-card">
    <div class="flex items-center justify-between gap-4">
      <h3 class="text-lg font-bold text-kyn-navy"><%= t("portal.applications.steps.principals") %></h3>
      <%= link_to t("portal.applications.review.edit"), portal_application_path(step: "principals"), class: "kyn-link inline-flex min-h-11 items-center px-1 text-[14px]" %>
    </div>
    <% principals = application.applicant.kyc_principals.active.to_a %>
    <% if principals.any? %>
      <ul class="mt-4 space-y-2 text-[15px] text-kyn-navy">
        <% principals.each do |principal| %>
          <li><%= principal.name %> — <%= t("applicants.show.principals.roles.#{principal.role}") %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-[15px] font-semibold text-kyn-error" data-testid="review-missing">
        <%= t("portal.applications.review.missing") %>
        <%= link_to t("portal.applications.review.missing_hint"), portal_application_path(step: "principals"), class: "underline" %>
      </p>
    <% end %>
  </section>

  <% if application.submitted? %>
    <p class="text-sm font-semibold text-kyn-success"><%= t("portal.applications.review.submitted_at", time: l(application.submitted_at, format: :long)) %></p>
  <% else %>
    <%= form_with url: portal_application_path, method: :patch, class: "flex justify-end" do %>
      <%= hidden_field_tag :step, "review" %>
      <%= submit_tag t("portal.applications.review.submit"), class: "kyn-btn-primary sm:w-60" %>
    <% end %>
  <% end %>
</div>
