<%# The calm "set a password" banner (MH-408). Never blocks anything. %>
<section id="password-prompt" class="mb-4 rounded-kyn-md bg-kyn-primary-tint p-4" aria-labelledby="password-prompt-title">
  <h2 id="password-prompt-title" class="text-sm font-bold text-kyn-navy"><%= t(".title") %></h2>
  <p class="mt-1 text-[13px] leading-5 text-kyn-slate"><%= t(".body") %></p>
  <div class="mt-2 flex items-center gap-5">
    <%= button_to t(".set"), portal_password_setup_path, method: :post, form: { class: "inline" },
          class: "kyn-link inline-flex min-h-[44px] items-center text-[13px]" %>
    <%= button_to t(".not_now"), portal_password_prompt_dismissal_path, method: :post, form: { class: "inline" },
          class: "inline-flex min-h-[44px] items-center text-[13px] text-kyn-slate hover:underline" %>
  </div>
</section>
