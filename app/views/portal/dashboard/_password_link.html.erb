<%# The permanent way to set (or change) a password; does the same as the banner button (MH-408). %>
<div id="password-link" class="mt-4 flex justify-center">
  <% if current_applicant_user.password_set? %>
    <%= button_to t(".change"), portal_password_setup_path, method: :post,
          class: "kyn-link inline-flex min-h-[44px] items-center text-[13px]" %>
  <% else %>
    <%= button_to t(".set"), portal_password_setup_path, method: :post,
          class: "kyn-link inline-flex min-h-[44px] items-center text-[13px]" %>
  <% end %>
</div>
