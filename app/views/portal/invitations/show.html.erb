<% content_for :title, t("portal.invitations.show.page_title") %>

<%= render "layouts/applicant_auth_card",
      eyebrow: t("portal.invitations.show.eyebrow"),
      title: t("portal.invitations.show.title", company: @invitation.applicant.name) do %>
  <p class="-mt-3 mb-6 text-[15px] leading-6 text-kyn-slate"><%= t("portal.invitations.show.intro") %></p>

  <ol class="mb-6 space-y-3 border-t border-kyn-border pt-6">
    <% %i[account questions documents].each_with_index do |step, index| %>
      <li class="flex items-start gap-3 text-[15px] leading-6 text-kyn-navy">
        <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-kyn-primary-tint text-xs font-semibold text-kyn-primary-text" aria-hidden="true"><%= index + 1 %></span>
        <span><%= t("portal.invitations.show.steps.#{step}") %></span>
      </li>
    <% end %>
  </ol>

  <div class="mb-6 flex items-center gap-3 rounded-kyn-md bg-kyn-primary-tint p-4">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="size-5 shrink-0" stroke="#4F5BF5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7.5 8 6 8-6"/>
    </svg>
    <div class="min-w-0">
      <p class="break-all text-[15px] font-semibold text-kyn-navy"><%= @invitation.email %></p>
      <p class="text-[13px] text-kyn-slate"><%= t("portal.invitations.show.address_note") %></p>
    </div>
  </div>

  <%= link_to t("portal.invitations.show.continue"), new_applicant_user_registration_path(invitation_token: params[:token]), class: "kyn-btn-primary" %>
<% end %>
