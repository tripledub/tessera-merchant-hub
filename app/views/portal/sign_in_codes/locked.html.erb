<%# Too many attempts (Auth / 3a). %>
<% content_for :title, t("portal.sign_in_codes.locked.page_title") %>

<%= render "layouts/applicant_auth_card",
      badge: render("layouts/applicant_badge", kind: :lock),
      title: t("portal.sign_in_codes.locked.title") do %>
  <p class="-mt-3 mb-6 text-sm leading-[22px] text-kyn-slate"><%= t("portal.sign_in_codes.locked.body") %></p>

  <%= button_to t("portal.sign_in_codes.locked.send_new"), portal_sign_in_code_resend_path, method: :post, class: "kyn-btn-primary" %>

  <%= render "portal/sign_in_codes/support" %>
<% end %>
