<%# Try again later (Auth / 3b): too many codes for the address, or too many requests from this connection. No button. %>
<% content_for :title, t("portal.sign_in_codes.try_again_later.page_title") %>

<%= render "layouts/applicant_auth_card",
      badge: render("layouts/applicant_badge", kind: :clock),
      title: t("portal.sign_in_codes.try_again_later.title") do %>
  <p class="-mt-3 text-sm leading-[22px] text-kyn-slate"><%= t("portal.sign_in_codes.try_again_later.body") %></p>

  <%= render "portal/sign_in_codes/support" %>
<% end %>
