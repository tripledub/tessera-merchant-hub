<%# Code expired (Auth / 3). Also shown for a code that was already used, or none. %>
<% content_for :title, t("portal.sign_in_codes.expired.page_title") %>

<%= render "layouts/applicant_auth_card",
      badge: render("layouts/applicant_badge", kind: :clock),
      title: t("portal.sign_in_codes.expired.title") do %>
  <p class="-mt-3 mb-6 text-sm leading-[22px] text-kyn-slate">
    <%= t("portal.sign_in_codes.expired.body") %>
    <span class="break-words font-medium text-kyn-navy"><%= pending_sign_in.email %></span>.
  </p>

  <%= button_to t("portal.sign_in_codes.expired.send_new"), portal_sign_in_code_resend_path, method: :post, class: "kyn-btn-primary" %>

  <%= render "portal/sign_in_codes/support" %>
<% end %>
