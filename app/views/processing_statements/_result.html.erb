<% present(processing_statement, ProcessingStatementPresenter) do |p| %>
  <div id="processing_statement_<%= processing_statement.id %>">
    <% if p.queued? %>
      <div class="card">
        <p class="text-theme-sm text-gray-500"><%= t('processing_statements.show.processing') %></p>
      </div>
    <% elsif p.failed? %>
      <div class="card">
        <p class="text-theme-sm text-red-500"><%= processing_statement.error_message %></p>
        <div class="mt-4 flex flex-wrap gap-3">
          <% if processing_statement.mappable? %>
            <%= link_to t("processing_statements.actions.remap"),
                  edit_processing_statement_path(processing_statement, context: "show"),
                  id: "map-processing-statement-#{processing_statement.id}",
                  class: "btn-secondary",
                  data: { turbo_frame: ProcessingStatementsController::MAPPING_MODAL_ID } %>
          <% end %>
          <% if processing_statement.removable? %>
            <%= button_to t("processing_statements.actions.remove"), processing_statement_path(processing_statement),
                  method: :delete,
                  class: "btn-danger",
                  data: { turbo_confirm: t("processing_statements.actions.remove_confirm") } %>
          <% end %>
        </div>
      </div>
    <% elsif p.ready? %>
      <div class="mb-6 flex justify-end">
        <%= link_to t('processing_statements.export.button'), export_processing_statement_path(processing_statement), class: "btn-secondary" %>
      </div>

      <% overall = p.overall %>

      <div class="card mb-6">
        <h2 class="mb-3 font-medium text-gray-900 dark:text-white/90"><%= t('processing_statements.show.overall') %></h2>
        <dl class="grid grid-cols-2 gap-4 sm:grid-cols-4">
          <div>
            <dt class="text-theme-sm text-gray-500"><%= t('processing_statements.show.total_volume') %></dt>
            <dd class="font-semibold text-gray-900 dark:text-white/90"><%= overall.total_volume %></dd>
          </div>
          <div>
            <dt class="text-theme-sm text-gray-500"><%= t('processing_statements.show.approved_volume') %></dt>
            <dd class="font-semibold text-gray-900 dark:text-white/90"><%= overall.approved_volume %></dd>
          </div>
          <div>
            <dt class="text-theme-sm text-gray-500"><%= t('processing_statements.show.declined_volume') %></dt>
            <dd class="font-semibold text-gray-900 dark:text-white/90"><%= overall.declined_volume %></dd>
          </div>
          <div>
            <dt class="text-theme-sm text-gray-500"><%= t('processing_statements.show.currencies_used') %></dt>
            <dd class="font-semibold text-gray-900 dark:text-white/90"><%= overall.currencies %></dd>
          </div>
          <div>
            <dt class="text-theme-sm text-gray-500"><%= t('processing_statements.show.chargebacks') %></dt>
            <dd class="font-semibold text-gray-900 dark:text-white/90"><%= overall.chargeback_count %> (<%= overall.chargeback_percentage %>%)</dd>
          </div>
          <div>
            <dt class="text-theme-sm text-gray-500"><%= t('processing_statements.show.refunds') %></dt>
            <dd class="font-semibold text-gray-900 dark:text-white/90"><%= overall.refund_count %> (<%= overall.refund_percentage %>%)</dd>
          </div>
        </dl>
      </div>

      <div class="card overflow-x-auto">
        <table class="min-w-full text-theme-sm">
          <thead>
            <tr class="text-left text-gray-500">
              <th class="py-2 pr-4"><%= t('processing_statements.show.month') %></th>
              <th class="py-2 pr-4"><%= t('processing_statements.show.total_volume') %></th>
              <th class="py-2 pr-4"><%= t('processing_statements.show.approved_volume') %></th>
              <th class="py-2 pr-4"><%= t('processing_statements.show.declined_volume') %></th>
              <th class="py-2 pr-4"><%= t('processing_statements.show.chargebacks') %></th>
              <th class="py-2 pr-4"><%= t('processing_statements.show.refunds') %></th>
              <th class="py-2"><%= t('processing_statements.show.currencies_used') %></th>
            </tr>
          </thead>
          <tbody>
            <% p.monthly_breakdown.each do |row| %>
              <tr class="border-t border-gray-100 dark:border-gray-800">
                <td class="py-2 pr-4 text-gray-900 dark:text-white/90"><%= row.label %></td>
                <td class="py-2 pr-4 text-gray-900 dark:text-white/90"><%= row.total_volume %></td>
                <td class="py-2 pr-4 text-gray-900 dark:text-white/90"><%= row.approved_volume %></td>
                <td class="py-2 pr-4 text-gray-900 dark:text-white/90"><%= row.declined_volume %></td>
                <td class="py-2 pr-4 text-gray-900 dark:text-white/90"><%= row.chargeback_count %> (<%= row.chargeback_percentage %>%)</td>
                <td class="py-2 pr-4 text-gray-900 dark:text-white/90"><%= row.refund_count %> (<%= row.refund_percentage %>%)</td>
                <td class="py-2 text-gray-900 dark:text-white/90"><%= row.currencies %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="card">
        <% if processing_statement.mappable? %>
          <%= link_to t("processing_statements.actions.map"),
                edit_processing_statement_path(processing_statement, context: "show"),
                id: "map-processing-statement-#{processing_statement.id}",
                class: "text-brand-600 hover:text-brand-700",
                data: { turbo_frame: ProcessingStatementsController::MAPPING_MODAL_ID } %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
