<div id="processing_statement_<%= processing_statement.id %>" data-controller="processing-statement-recovery">
  <%= render "processing_statements/result_content", processing_statement: processing_statement %>
  <% if recovery_allowed %>
    <div class="mt-4 flex flex-wrap gap-3">
      <%= render "processing_statements/recovery_controls", processing_statement: processing_statement, context: "show" %>
    </div>
  <% end %>
</div>
