<% if turbo_frame_request? %>
  <%= turbo_frame_tag ProcessingStatementsController::MAPPING_MODAL_ID do %>
    <%= render "mapping_modal",
          processing_statement: processing_statement,
          headers: @headers,
          context: @mapping_context,
          mapping_error: @mapping_error,
          mapping: @mapping || {} %>
  <% end %>
<% else %>
  <% content_for :title, t('.title') %>

  <div class="mb-6">
    <h1 class="text-xl font-semibold text-gray-900 dark:text-white/90"><%= t('.title') %></h1>
    <p class="mt-1 text-theme-sm text-gray-500"><%= t('.intro') %></p>
  </div>

  <div class="card max-w-xl">
    <%= render "mapping_form",
          processing_statement: processing_statement,
          headers: @headers,
          context: @mapping_context,
          mapping_error: @mapping_error,
          mapping: @mapping || {},
          modal: false %>
  </div>
<% end %>
