<% content_for :title, t('.title') %>

<div class="mb-6">
  <h1 class="text-xl font-semibold text-gray-900 dark:text-white/90"><%= t('.title') %></h1>
  <p class="mt-1 text-theme-sm text-gray-500"><%= t('.intro') %></p>
</div>

<div class="card max-w-xl">
  <%= form_with model: processing_statement, url: processing_statement_path(processing_statement),
        method: :patch, class: "space-y-4" do |f| %>
    <% %i[date amount currency outcome].each do |field| %>
      <div>
        <%= label_tag "processing_statement[#{field}]", t(".#{field}_label"), class: "form-label" %>
        <%= select_tag "processing_statement[#{field}]",
              options_for_select([ [ t('.unmapped'), "" ] ] + @headers.map { |h| [ h, h ] },
                processing_statement.column_mapping[field.to_s]),
              class: "form-input" %>
      </div>
    <% end %>

    <div class="pt-2">
      <%= f.submit t('.submit'), class: "btn-primary" %>
    </div>
  <% end %>
</div>
